{
  "trailingSlash": true,
  "redirects": [
    { "source": "/screen", "destination": "/", "permanent": true },
    { "source": "/screen/(.*)", "destination": "/", "permanent": true },
    { "source": "/freeman", "destination": "/freeman-general-contracting/", "permanent": false },
    { "source": "/kashus", "destination": "/kashus-culpepper/", "permanent": false },
    { "source": "/scout", "destination": "/scout-motors/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] }
  ]
}
